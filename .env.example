APP_NAME=GoActivity
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_LAN_ACCESS=false
ADMIN_TOKEN=
DATABASE_URL=sqlite:///storage/app.db
STORAGE_DIR=storage

# we-mp-rss
WE_MP_RSS_BASE_URL=http://localhost:8001
WE_MP_RSS_API_BASE=/api/v1/wx
WE_MP_RSS_ACCESS_KEY=
WE_MP_RSS_SECRET_KEY=

# OCR Provider (mock | disabled | rapid | openai_compatible)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_API_BASE_URL=https://api.openai.com/v1
OCR_API_MODEL=gpt-4o-mini
OCR_API_TIMEOUT_SECONDS=60
OCR_MAX_IMAGES=5

# Vision Provider (mock | openai_compatible | textai)
VISION_API_PROVIDER=mock
VISION_API_KEY=
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_MODEL=gpt-4.1-mini
VISION_API_TIMEOUT_SECONDS=60
VISION_MAX_IMAGES=5
VISION_MAX_TOKENS=4096

# 文本 AI Provider (disabled | mock | openai_compatible)
TEXT_AI_PROVIDER=disabled
TEXT_AI_API_KEY=
TEXT_AI_API_BASE_URL=https://api.openai.com/v1
TEXT_AI_API_MODEL=gpt-4.1-mini
TEXT_AI_API_TIMEOUT_SECONDS=60
TEXT_AI_MAX_TOKENS=4096

# 飞书
FEISHU_PROVIDER=auto
FEISHU_CLI_PATH=lark-cli
FEISHU_CLI_AS=user
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_POSTER_ATTACHMENT_FIELD=海报附件
FEISHU_ACTIVITY_KIND_FIELD=活动类型
FEISHU_ACTIVITY_KIND_CODE_FIELD=活动类型编码
FEISHU_DRY_RUN=true
FEISHU_MAX_RETRIES=3
FEISHU_RETRY_DELAY_SECONDS=1.0

# 飞书机器人
FEISHU_BOT_ENABLED=false
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
FEISHU_BOT_RATE_LIMIT=10

# 自动同步（cron 表达式，默认每小时同步一次）
AUTO_SYNC_CRON=0 * * * *

# 自动归档（过期天数，0=禁用）
AUTO_ARCHIVE_EXPIRED_DAYS=30

# 日报/周报
FEISHU_REPORT_CHAT_ID=
FEISHU_REPORT_USER_ID=
FEISHU_REPORT_DAILY_CRON=0 9 * * *
FEISHU_REPORT_WEEKLY_CRON=0 9 * * 1
FEISHU_REPORT_DAILY_ENABLED=true
FEISHU_REPORT_WEEKLY_ENABLED=true
