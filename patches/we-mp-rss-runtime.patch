diff --git a/tests/test_collection_guard.py b/tests/test_collection_guard.py
new file mode 100644
index 0000000000000000000000000000000000000000..689dd95d65edbc7d527d9323cc0b006820e1d918
--- /dev/null
+++ b/tests/test_collection_guard.py
@@ -0,0 +1,56 @@
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from core.collection_guard import CollectionGuard, guarded_collection
+
+
+class CollectionGuardTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.now = 10000
+        self.path = Path(self.directory.name) / "state.json"
+        self.guard = CollectionGuard(self.path, clock=lambda: self.now)
+
+    def test_duplicate_and_interval(self):
+        self.assertTrue(self.guard.enqueue("a")[0])
+        self.assertFalse(self.guard.enqueue("a")[0])
+        self.assertTrue(self.guard.begin("a")[0])
+        self.assertFalse(self.guard.begin("a")[0])
+        self.guard.finish("a")
+        self.assertFalse(self.guard.enqueue("a")[0])
+        self.now += 300
+        self.assertTrue(self.guard.enqueue("a")[0])
+
+    def test_persistent_global_exponential_cooldown(self):
+        for expected in (1800, 3600, 7200, 7200):
+            self.guard.rate_limited()
+            loaded = CollectionGuard(self.path, clock=lambda: self.now)
+            self.assertEqual(loaded.status()["remaining_seconds"], expected)
+            self.assertFalse(loaded.begin("other")[0])
+            self.now += expected
+        self.guard.success()
+        self.guard.rate_limited()
+        self.assertEqual(self.guard.status()["remaining_seconds"], 1800)
+
+    def test_exception_releases_active_account(self):
+        class Collector:
+            @guarded_collection
+            def collect(self, faker_id="", Mps_id=""):
+                raise ValueError("test")
+        with patch("core.collection_guard.collection_guard", self.guard):
+            with self.assertRaises(ValueError):
+                Collector().collect(Mps_id="a")
+        self.assertEqual(self.guard.status()["active_count"], 0)
+
+    def test_failed_persistence_does_not_leave_active_account(self):
+        with patch.object(self.guard, "_save", side_effect=OSError("test")):
+            with self.assertRaises(OSError):
+                self.guard.begin("a")
+        self.assertEqual(self.guard.status()["active_count"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_qrcode_image.py b/tests/test_qrcode_image.py
new file mode 100644
index 0000000000000000000000000000000000000000..76d962fc7fae1ff09fc905b3b91e005d074850a2
--- /dev/null
+++ b/tests/test_qrcode_image.py
@@ -0,0 +1,36 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+from driver.qrcode import validate_qrcode_image
+
+
+class QRCodeImageTests(unittest.TestCase):
+    def test_rejects_blank_page_screenshot(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "qr.png"
+            Image.new("RGB", (1834, 1005), "white").save(path)
+            with self.assertRaises(ValueError):
+                validate_qrcode_image(path)
+
+    def test_rejects_tiny_image(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "qr.png"
+            image = Image.new("RGB", (40, 40), "white")
+            ImageDraw.Draw(image).rectangle((0, 0, 20, 40), fill="black")
+            image.save(path)
+            with self.assertRaises(ValueError):
+                validate_qrcode_image(path)
+
+    def test_accepts_loaded_image(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "qr.png"
+            image = Image.new("RGB", (200, 200), "white")
+            ImageDraw.Draw(image).rectangle((20, 20, 80, 80), fill="black")
+            image.save(path)
+            validate_qrcode_image(path)
+
+
+if __name__ == "__main__":
+    unittest.main()
