diff --git a/core/collection_guard.py b/core/collection_guard.py
new file mode 100644
index 0000000000000000000000000000000000000000..2a1fa132ab5b91f272de19b64fa99f1195ebe93b
--- /dev/null
+++ b/core/collection_guard.py
@@ -0,0 +1,111 @@
+"""Shared deduplication and persistent WeChat rate-limit cooldown."""
+import json
+import os
+import threading
+import time
+from functools import wraps
+from pathlib import Path
+
+
+class CollectionGuard:
+    def __init__(self, path=None, clock=time.time, min_interval=300):
+        self.path = Path(path) if path else Path(__file__).resolve().parents[1] / "data" / "collection-state.json"
+        self.clock = clock
+        self.min_interval = min_interval
+        self.lock = threading.Lock()
+        self.pending = {}
+        self.active = set()
+        try:
+            self.state = json.loads(self.path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            self.state = {}
+        if not isinstance(self.state, dict):
+            self.state = {}
+
+    def _save(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(self.state), encoding="utf-8")
+        os.replace(temporary, self.path)
+
+    def _reason(self, mp_id):
+        if self.state.get("cooldown_until", 0) > self.clock():
+            return "微信接口限频，采集已进入冷却期"
+        if mp_id in self.active:
+            return "该公众号正在采集"
+        attempts = self.state.get("attempts", {})
+        if mp_id in attempts and self.clock() - attempts[mp_id] < self.min_interval:
+            return "该公众号近期已尝试采集，请稍后再试"
+        return ""
+
+    def enqueue(self, mp_id):
+        with self.lock:
+            self.pending = {key: expires for key, expires in self.pending.items() if expires > self.clock()}
+            reason = self._reason(mp_id)
+            if mp_id in self.pending:
+                reason = reason or "该公众号已在采集队列中"
+            if reason:
+                return False, reason
+            self.pending[mp_id] = self.clock() + 1800
+            return True, ""
+
+    def begin(self, mp_id):
+        with self.lock:
+            self.pending.pop(mp_id, None)
+            reason = self._reason(mp_id)
+            if reason:
+                return False, reason
+            self.active.add(mp_id)
+            attempts = self.state.setdefault("attempts", {})
+            attempts[mp_id] = self.clock()
+            self.state["attempts"] = {key: value for key, value in attempts.items() if self.clock() - value < 86400}
+            try:
+                self._save()
+            except OSError:
+                self.active.discard(mp_id)
+                attempts.pop(mp_id, None)
+                self.state["attempts"].pop(mp_id, None)
+                raise
+            return True, ""
+
+    def finish(self, mp_id):
+        with self.lock:
+            self.active.discard(mp_id)
+            self.pending.pop(mp_id, None)
+
+    def rate_limited(self):
+        with self.lock:
+            strikes = min(self.state.get("strikes", 0) + 1, 3)
+            self.state.update(strikes=strikes, cooldown_until=self.clock() + 1800 * 2 ** (strikes - 1))
+            self._save()
+
+    def success(self):
+        with self.lock:
+            self.state["strikes"] = 0
+            self._save()
+
+    def status(self):
+        with self.lock:
+            remaining = max(0, int(self.state.get("cooldown_until", 0) - self.clock()))
+            return {"cooldown": remaining > 0, "remaining_seconds": remaining,
+                    "retry_at": self.state.get("cooldown_until", 0),
+                    "pending_count": len(self.pending), "active_count": len(self.active)}
+
+
+collection_guard = CollectionGuard()
+
+
+def guarded_collection(function):
+    @wraps(function)
+    def wrapped(self, faker_id="", Mps_id="", *args, **kwargs):
+        key = Mps_id or faker_id
+        allowed, reason = collection_guard.begin(key)
+        self.collection_error = ""
+        if not allowed:
+            self.collection_error = reason
+            return None
+        try:
+            return function(self, faker_id, Mps_id, *args, **kwargs)
+        finally:
+            collection_guard.finish(key)
+    return wrapped
